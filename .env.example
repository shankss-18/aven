# ──────────────────────────────────────────────────────────────────────────────
# AVEN Environment Variables — copy this to .env.local for local dev
# Add ALL of these to your Vercel project: Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# Turso (SQLite edge database)
TURSO_DATABASE_URL=libsql://<your-db-name>.turso.io
TURSO_AUTH_TOKEN=<your-turso-auth-token>

# JSON Web Tokens (for admin auth)
JWT_SECRET=<generate-a-long-random-string>

# Razorpay (payment gateway)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<your-razorpay-secret>

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Public base URL — used for SEO/sitemap/OG tags
# Set to your Vercel domain once deployed, e.g. https://aven-store.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Razorpay public key (exposed to browser for checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
